{
  "name": "@anyreplay/tauri",
  "version": "0.2.3",
  "description": "Session replay for Tauri v2 apps: records the window with the AnyReplay browser SDK, reports the app's identifier and version, and flushes when the window loses focus.",
  "license": "MIT",
  "homepage": "https://anyreplay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baemtech/anyreplay-sdk.git",
    "directory": "tauri"
  },
  "bugs": {
    "url": "https://github.com/baemtech/anyreplay-sdk/issues"
  },
  "keywords": [
    "session-replay",
    "session-recording",
    "tauri",
    "desktop",
    "anyreplay"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anyreplay/browser": "workspace:^"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.1",
    "jsdom": "25.0.1",
    "tsup": "8.3.5",
    "typescript": "5.8.3",
    "vitest": "2.1.8"
  }
}
