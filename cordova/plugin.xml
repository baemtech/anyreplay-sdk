<?xml version="1.0" encoding="UTF-8"?>
<!--
  @anyreplay/cordova — session replay for Cordova apps.

  The JavaScript (dist/anyreplay.js) is @anyreplay/browser plus the app-shell
  core it shares with @anyreplay/capacitor, bundled into one module and
  installed as window.AnyReplay. The native classes are deliberately small:
  the app id, version and device model, and one string of storage that
  survives the web view's storage being cleared. Pause and resume come from
  Cordova's own document events. See docs/SDK-CONTRACT.md §9.2.

  The version below is checked against package.json by the package's tests.
-->
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="@anyreplay/cordova"
        version="0.2.3">
  <name>AnyReplay</name>
  <description>Session replay for Cordova apps.</description>
  <license>MIT</license>
  <keywords>session-replay,anyreplay</keywords>

  <engines>
    <engine name="cordova-android" version=">=10.0.0" />
    <engine name="cordova-ios" version=">=6.0.0" />
  </engines>

  <js-module src="dist/anyreplay.js" name="AnyReplay">
    <clobbers target="AnyReplay" />
  </js-module>

  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="AnyReplay">
        <param name="android-package" value="com.anyreplay.cordova.AnyReplay" />
      </feature>
    </config-file>
    <source-file src="native/android/com/anyreplay/cordova/AnyReplay.java" target-dir="src/com/anyreplay/cordova" />
  </platform>

  <platform name="ios">
    <config-file target="config.xml" parent="/*">
      <feature name="AnyReplay">
        <param name="ios-package" value="CDVAnyReplay" />
      </feature>
    </config-file>
    <header-file src="native/ios/CDVAnyReplay.h" />
    <source-file src="native/ios/CDVAnyReplay.m" />
  </platform>
</plugin>
